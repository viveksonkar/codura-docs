# Codura Docs — local-first defaults (NFR-01). Copy to .env:  cp .env.example .env
# Every value works locally as-is; production must override every secret (startup refuses defaults).

# --- Compose ------------------------------------------------------------------------------------
# GPU on by default (GTX 1060 6 GB dev box, ADR-0018). CPU-only machine: COMPOSE_FILE=docker-compose.yml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:compose.gpu.yml
# Developers who run backend tests from the host also add compose.dev.yml (publishes Postgres on 127.0.0.1:5432):
# COMPOSE_FILE=docker-compose.yml:compose.gpu.yml:compose.dev.yml
HTTP_PORT=8080

# --- App ----------------------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:8080

# --- Postgres (owner runs migrations; app/worker/platform roles are non-owner, RLS applies) ------
POSTGRES_USER=codura_owner
POSTGRES_PASSWORD=codura
POSTGRES_DB=codura_docs
DB_APP_PASSWORD=codura_app
DB_WORKER_PASSWORD=codura_worker
DB_PLATFORM_PASSWORD=codura_platform

# --- Secrets (SEC-12, SEC-17) -------------------------------------------------------------------
SESSION_SECRET=dev-only-change-me
# 32 random bytes, base64. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SECRETS_MASTER_KEY=Y29kdXJhLWRldi1vbmx5LWtleS1jaGFuZ2UtbWUhISE=
SECRETS_KEY_VERSION=1
SECRETS_PREVIOUS_KEYS=

# --- First boot ---------------------------------------------------------------------------------
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=platform@local.test
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=admin
# Demo Tenant "demo": Tenant Admin admin@demo.test / Tenant User user@demo.test (password: demo-password)
SEED_DEMO_TENANT=true

# --- Models (ADR-0015, ADR-0018); tags verified 2026-11-19 ---------------------------------------
# qwen3:4b-instruct-2507 = non-thinking Qwen3 4B (Apache-2.0). The plain `qwen3:4b` tag is the
# Thinking-2507 model: it always reasons first (slow, wasted tokens), so it is not the default.
OLLAMA_PULL_MODELS=bge-m3,qwen3:4b-instruct-2507-q4_K_M
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m
# 6 GB GPU: one slot + flash attention + 8-bit KV cache keeps chat and embeddings both in VRAM.
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
# Tesseract language packs baked into the backend image (Debian package suffixes, ADR-0016)
OCR_LANG_PACKS=eng hin spa fra deu ara chi-sim

# --- Blob Store (ADR-0009) ----------------------------------------------------------------------
BLOB_STORE=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Email (Mailpit locally: http://localhost:8025) ---------------------------------------------
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=no-reply@codura.local

# --- Limits -------------------------------------------------------------------------------------
MAX_UPLOAD_MB=50

# --- Public Chat API abuse limits (SEC-06; per api process, M6 adds a shared RateLimiter) -------
# Token buckets refill per minute; 0 disables one. Concurrency caps stop one Tenant starving the LLM.
CHAT_RATE_PER_KEY_PER_MIN=60
CHAT_RATE_PER_TENANT_PER_MIN=120
CHAT_RATE_PER_VISITOR_PER_MIN=10
CHAT_MAX_CONCURRENT_PER_KEY=4
CHAT_MAX_CONCURRENT_PER_TENANT=6
CHAT_MAX_QUESTION_CHARS=2000
PUBLIC_RATE_PER_IP_PER_MIN=120
HOSTED_LOOKUP_PER_IP_PER_MIN=30
MAX_PAGES=500
WORKER_CONCURRENCY=2

# --- Billing (specs/billing.md, ADR-0026) --------------------------------------------------------
# Plans, prices and quotas live in the database (Platform Console > Plans). Currency follows the
# Tenant's billing country: India -> INR, everyone else -> USD.
# `manual` makes no network calls (NFR-01): upgrades apply at once, Platform Admins mark invoices paid.
PAYMENT_PROVIDER=manual
# Stripe (test mode first): set both, then PAYMENT_PROVIDER=stripe. Webhook endpoint:
#   ${PUBLIC_BASE_URL}/api/webhooks/payments/stripe
#   events: checkout.session.completed, invoice.paid, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Worker schedules rollups (hourly), usage snapshots (daily) and the billing cycle (hourly).
BILLING_SCHEDULER_ENABLED=true
