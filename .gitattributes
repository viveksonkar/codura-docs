# Normalise line endings; scripts and container files must stay LF even on Windows checkouts.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
Caddyfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
*.docx binary
